    },
    {
      "name": "Uruguayan sparkling water",
      "amount": "1 cup",
      "notes": "or any carbonated water"
    },
    {
      "name": "Pilaf vegetable oil",
      "amount": "1 cup",
      "notes": "for frying"
    },
    {
      "name": "Egg",
      "amount": "1",
      "notes": "beaten"
    },
    {
      "name": "Soda water",
      "amount": "1/2 cup",
      "notes": "optional"
    }
  ],
  "instructions": [
    "1. In a large mixing bowl, whisk together rice flour and cornstarch.",
    "2. Gradually pour in sparkling water and mix until smooth, creating a light tempura batter.",
    "3. Dip crushed Oreos into the batter, making sure they are fully coated.",
    "4. Fry battered Oreos in hot vegetable oil at 350°F (180°C) until golden brown, about 2-3 minutes.",
    "5. Drain excess oil on paper towels and dust with additional cornstarch if desired.",
    "6. Serve warm and enjoy!"
  ],
