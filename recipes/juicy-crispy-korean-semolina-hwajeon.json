    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon",
      "notes": ""
    },
    {
      "name": "sesame seeds",
      "amount": "2 tablespoons",
      "notes": ""
    }
  ],
  "instructions": [
    "Mix flour and semolina in a large bowl.",
    "Add grated orange and lemon peels, and mix well.",
    "Gradually add water, mixing until a smooth dough forms.",
    "Knead the dough for about 10 minutes until it becomes elastic and smooth.",
    "Divide the dough into small pieces, about the size of a small egg.",
    "Heat vegetable oil in a non-stick skillet over medium heat.",
    "Roll out each piece of dough into a thin circle, and fry until golden brown.",
    "Drain excess oil on paper towels, and sprinkle with sesame seeds.",
    "Serve immediately, and enjoy!"
