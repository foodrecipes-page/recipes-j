{
  "title": "Juicy Umami Indian Tofu Curry",
  "description": "A quick, umami-packed tofu curry with coriander seed tempering, ideal for a weeknight Australian dinner.",
  "cuisine": "Indian",
  "diet": [
    "jain-friendly"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "firm tofu",
      "amount": "800 g",
      "notes": "cut into 1‑cm cubes"
    },
    {
      "name": "coconut milk",
      "amount": "800 ml"
    },
    {
      "name": "tamari or soy sauce",
      "amount": "8 tbsp"
    },
    {
      "name": "tomato puree",
      "amount": "200 g"
    },
    {
      "name": "vegetable oil",
      "amount": "1 tbsp"
    },
    {
      "name": "coriander seeds",
      "amount": "2 tsp"
    },
    {
      "name": "mustard seeds",
      "amount": "1 tsp"
    },
    {
      "name": "cumin seeds",
      "amount": "1 tsp"
    },
    {
      "name": "fenugreek seeds",
      "amount": "½ tsp"
    },
    {
      "name": "turmeric powder",
      "amount": "1 tsp"
    },
    {
      "name": "garam masala",
      "amount": "1 tsp"
    },
    {
      "name": "fresh coriander",
      "amount": "to garnish",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Set a large pan over medium heat and add the vegetable oil.",
    "Add coriander seeds, mustard seeds, cumin seeds, and fenugreek seeds to the hot oil; let them sizzle for 30 seconds.",
    "Pour in the tomato puree, stir, and cook for 2 minutes until the oil begins to separate.",
    "Add turmeric and garam masala, stir for 30 seconds then pour in coconut milk.",
    "Bring the mixture to a gentle simmer, then add the tofu cubes and tamari.",
    "Simmer, uncovered, for 10 minutes until the tofu is heated through and the sauce has thickened slightly.",
    "Taste and adjust seasoning with salt and more tamari if needed.",
    "Serve hot, garnished with chopped fresh coriander, with rice or naan."
  ],
