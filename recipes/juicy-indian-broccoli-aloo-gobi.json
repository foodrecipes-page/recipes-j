  "instructions": [
    "Heat the ghee in a large pan over medium heat.",
    "Add the onion and cook until it is translucent.",
    "Add the garlic and ginger and cook for 1 minute.",
    "Add the potatoes and cook for 5 minutes.",
    "Add the broccoli and cook until it is tender.",
    "Add the garam masala and amchur powder and stir to combine.",
    "Add the paneer cheese and stir until it is melted and well combined.",
    "Season with salt to taste.",
    "Serve hot in a bento box."
