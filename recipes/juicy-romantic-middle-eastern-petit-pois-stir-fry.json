      "name": "1 cup petit pois",
      "amount": "cup"
    },
    {
      "name": "2 tablespoons olive oil",
      "amount": "tablespoons"
    },
    {
      "name": "Juice of 1 lemon",
      "amount": "juice of 1 lemon"
    },
    {
      "name": "Juice of 1 lime",
      "amount": "juice of 1 lime"
    },
    {
      "name": "Pinch of cumin",
      "notes": "to taste"
    },
    {
      "name": "Pinch of coriander seeds",
      "amount": "pinch"
    },
    {
      "name": "2 cloves garlic, minced",
      "amount": "cloves"
    },
    {
      "name": "2 medium carrots, sliced thinly",
      "amount": "medium"
    },
    {
      "name": "1 small onion, finely chopped",
      "amount": "onion"
    },
    {
      "name": "1 cup cherry tomatoes, halved",
      "amount": "cup"
    },
    {
      "name": "1 bunch fresh parsley, roughly chopped",
      "notes": "for garnish"
    }
  ],
  "instructions": [
    "Heat olive oil in a wok or large skillet over medium-high heat.",
    "Add lemon and lime juices, cumin, coriander seeds, and garlic. Stir-fry for about 1 minute until fragrant but not browned.",
    "Toss in carrots and onion. Cook for an additional 3-4 minutes until onions are translucent.",
    "Stir in cherry tomatoes. Sauté for another 2-3 minutes until tomatoes soften slightly.",
    "Fold in petit pois. Stir gently to prevent crushing the petits pois. Add more lemon or lime juice if needed to maintain juiciness.",
    "Garnish with chopped parsley and serve immediately."
  ],
