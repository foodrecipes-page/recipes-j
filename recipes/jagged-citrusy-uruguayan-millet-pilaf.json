      "notes": "rinsed and drained"
    },
    {
      "name": "water",
      "amount": "2 cups"
    },
    {
      "name": "shio-cure",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "orange zest",
      "amount": "1 tablespoon"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the olive oil in a kadhai over medium heat.",
    "Add the millet and cook for 2 minutes, stirring constantly.",
    "Add the water, shio-cure, lemon juice, orange zest, salt, and black pepper, and bring to a boil.",
    "Reduce the heat to low, cover, and simmer for 15 minutes.",
    "Remove the lid and stir in the chopped scallions.",
    "Continue to cook for an additional 2 minutes, or until the liquid is absorbed.",
    "Remove from heat and let cool for 5 minutes.",
    "Fluff the pilaf with a fork and serve hot."
  ],
