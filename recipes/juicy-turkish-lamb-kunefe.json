  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "boneless, cut into 1 inch pieces"
    },
    {
      "name": "shio-koji",
      "amount": "2 tablespoons"
    },
    {
      "name": "tempering chocolate",
      "amount": "1 ounce"
    },
    {
      "name": "red wine",
      "amount": "1 cup"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "kunefe pastry",
      "amount": "1 package",
      "notes": "thawed"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "Heat the olive oil in the paella pan over medium high heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the lamb shoulder and cook until it is browned on all sides.",
    "Add the red wine, shio-koji, salt, and black pepper, and stir to combine.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 10 minutes.",
    "Arrange the kunefe pastry in the paella pan, on top of the lamb mixture.",
    "Melt the tempering chocolate and drizzle it over the kunefe pastry.",
    "Transfer the paella pan to the preheated oven and bake for 20 minutes."
  ],
