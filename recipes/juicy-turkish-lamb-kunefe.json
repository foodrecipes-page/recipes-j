{
  "title": "Juicy Turkish Lamb Kunefe",
  "description": "A winey, juicy Turkish dish featuring shio-koji and tempering chocolate, made in a paella pan and suitable for low-glycemic diets.",
  "cuisine": "Turkish",
  "diet": [
    "low-glycemic",
    "gluten-free"
