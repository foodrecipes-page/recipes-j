{
  "title": "Juicy Garlic Turkish Stir-fry",
  "description": "This dish features a blend of bitter and juicy elements marinated in garlic granules to serve as a hangover cure.",
  "cuisine": "Turkish",
  "diet": [
    "plant-based"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "soaked dried apricots",
      "amount": "1 cup"
    },
    {
      "name": "dried figs",
      "amount": "2 cups"
    },
    {
      "name": "sesame oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic granules",
      "amount": "2 tablespoons"
    },
    {
      "name": "red bell pepper, diced",
      "amount": "1 cup"
    },
    {
      "name": "cilantro leaves",
      "amount": "handful"
    },
    {
      "name": "lime juice",
      "amount": "1/4 cup"
    },
    {
      "name": "rice vinegar",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat sesame oil in a wok or large frying pan over medium-high heat.",
    "Add garlic granules and stir-fry for about 30 seconds until fragrant.",
    "Add diced red bell pepper to the pan, tossing occasionally for about 5 minutes until slightly softened.",
    "Drain soaked dried apricots and figs; add them along with cilantro leaves to the pan. Toss well.",
    "Pour in rice vinegar and lime juice, then toss again for a few seconds to coat all ingredients evenly.",
    "Season with salt or other seasonings of your choice if needed."
  ],
