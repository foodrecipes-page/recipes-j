      "name": "Bellflower-Root-Doraji",
      "amount": "2 large roots"
    },
    {
      "name": "Olive Oil",
      "amount": "1/4 cup"
    },
    {
      "name": "Lemon Juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "Minced Garlic",
      "amount": "3 cloves"
    },
    {
      "name": "Chopped Fresh Oregano",
      "amount": "1 tablespoon"
    },
    {
      "name": "Salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "Black Pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "Agave Leaves",
      "amount": "4 large leaves"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "Cut the bellflower-root-doraji into thick slices.",
    "In a small bowl, whisk together olive oil, lemon juice, minced garlic, chopped fresh oregano, salt, and black pepper.",
    "Place the bellflower-root-doraji slices in a single layer in the agave leaves, brushing with the olive oil mixture.",
    "Roast in the preheated oven for 30 minutes.",
    "Remove from the oven and let cool for 10 minutes.",
    "Serve warm, garnished with additional fresh oregano if desired."
