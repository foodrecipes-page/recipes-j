      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "carrots",
      "amount": "2 large",
      "notes": "peeled and chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 large",
      "notes": "peeled and chopped"
    },
    {
      "name": "lotus leaves",
      "amount": "4 large",
      "notes": "fresh"
    }
  ],
  "instructions": [
    "Heat the lard in a large pot over medium heat.",
    "Add the garlic and cook until fragrant, about 1 minute.",
    "Add the pork and cook until browned on all sides, about 5 minutes.",
    "Add the rosemary, onions, carrots, and potatoes, and cook until the vegetables are tender, about 20 minutes.",
    "Season with salt and pepper to taste.",
    "Wrap the stew in the lotus leaves and cook for an additional 10 minutes.",
    "Serve hot, garnished with chopped rosemary.",
    "Let the stew rest for 10 minutes before serving.",
    "Serve with crusty bread or over rice."
  ],
