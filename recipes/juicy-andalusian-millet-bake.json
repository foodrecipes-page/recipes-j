      "amount": "1/4 cup",
      "notes": ""
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "chicken broth",
      "amount": "1 cup",
