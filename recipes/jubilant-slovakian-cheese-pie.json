      "amount": "1 tbsp"
    },
    {
      "name": "ground black pepper",
      "amount": "1 tsp"
    },
    {
      "name": "dried oregano",
      "amount": "1 tsp"
    }
  ],
  "instructions": [
    "Preheat oven to 200°C.",
    "Heat oil in a skillet to 150°C and fry puff pastry squares for 2 minutes.",
    "Increase oil temperature to 180°C, fry squares another 2 minutes, then drain on paper towels.",
    "In a bowl combine shredded cheeses, oat milk, soy sauce, vinegar, sugar, pepper, and oregano.",
    "Place the cheese mixture onto the fried pastry squares, leaving a 2 cm border.",
    "Fold the edges over the filling and seal the seams.",
    "Bake the assembled pies for 15 minutes until golden brown.",
    "Slice and serve warm as a midnight craving treat."
  ],
