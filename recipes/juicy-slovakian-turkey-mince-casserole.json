      "amount": "100ml"
    },
    {
      "name": "paprika",
      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "0.5 tsp"
    }
  ],
  "instructions": [
    "Preheat the oven to 180 degrees Celsius",
    "In a large bowl, combine the turkey mince, chopped onion, grated carrot, paprika, salt, and black pepper, and mix well",
    "In a separate bowl, whisk together the egg and milk",
    "Add the cubed double-rise-bread to the egg mixture and mix until the bread is well coated",
    "Add the bread mixture to the turkey mince mixture and mix until just combined",
    "Transfer the mixture to a large mason jar",
    "Top the mixture with the shredded cheddar cheese",
    "Cover the mason jar with a lid and bake for 30 minutes",
    "Remove the lid and continue baking for an additional 10 minutes, or until the cheese is melted and bubbly"
  ],
