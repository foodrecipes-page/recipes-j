{
  "title": "Juicy Crisp Spanish Chicken Tagine",
  "description": "A paleo-friendly Spanish dish featuring mascarpone and cooked in a tagine, perfect for a crowd, with a grassy and crisp flavor profile.",
  "cuisine": "Spanish",
  "diet": [
    "paleo"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "chicken thighs",
      "amount": "1 1/2 pounds",
      "notes": "bone-in, skin-on"
    },
    {
      "name": "mascarpone cheese",
      "amount": "1/2 cup"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 425 degrees Fahrenheit.",
    "Season the chicken thighs with salt, black pepper, and paprika.",
    "Heat the olive oil in the tagine over medium-high heat.",
    "Sear the chicken thighs until browned on all sides, about 5 minutes per side.",
    "Add the garlic, lemon juice, and mascarpone cheese to the tagine.",
    "Cover the tagine and transfer it to the preheated oven.",
    "Bake for 25 minutes, then remove the cover and continue baking for an additional 10 minutes.",
    "Garnish with chopped fresh parsley and serve hot."
  ],
