{
  "title": "Jubilant Tender Mexican Beef Birria",
  "description": "A pungent and tender Mexican dish featuring Massaman curry paste, perfect for festive occasions, this birria is onion and garlic free.",
  "cuisine": "Mexican",
  "diet": [
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "beef brisket",
      "amount": "2 pounds",
      "notes": "cut into large pieces"
    },
    {
      "name": "Massaman curry paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "diced tomatoes",
      "amount": "1 can"
    },
    {
      "name": "beef broth",
      "amount": "2 cups"
    },
    {
      "name": "lard or vegetable oil",
      "amount": "1/4 cup"
    },
    {
      "name": "ground cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh cilantro",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit.",
    "In a large Dutch oven, heat the lard or oil over medium heat.",
    "Add the Massaman curry paste and cook, stirring constantly, for 1 minute.",
    "Add the beef pieces and cook until browned on all sides, about 5 minutes.",
    "Add the cumin, paprika, salt, and pepper, and stir to combine.",
    "Add the diced tomatoes and beef broth, and bring to a boil.",
    "Cover the pot and transfer to the preheated oven.",
    "Bake for 2 1/2 hours, or until the beef is tender.",
    "Remove the pot from the oven and let cool slightly.",
    "Serve the birria hot, garnished with chopped cilantro."
  ],
