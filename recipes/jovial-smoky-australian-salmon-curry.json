      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat the tandoor clay pot to 400 degrees Fahrenheit.",
    "Season the salmon fillets with smoked paprika, salt, and black pepper.",
    "Heat the olive oil in the tandoor clay pot and sear the salmon fillets for 2 minutes on each side.",
    "Add the curry powder and cook for 1 minute, stirring constantly.",
    "Add the coconut milk and bring to a simmer.",
    "Reduce the heat to 350 degrees Fahrenheit and cook for 10 minutes, covered with a papillote.",
    "Fluff the brown rice with a fork and serve alongside the salmon curry.",
    "Drizzle with lemon juice and serve hot."
  ],
