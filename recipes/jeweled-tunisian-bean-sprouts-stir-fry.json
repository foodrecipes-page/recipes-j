      "name": "bean sprouts",
      "amount": "1 cup",
      "notes": "fresh"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "pomegranate molasses",
      "amount": "2 tablespoons"
    },
    {
      "name": "soy sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "sesame seeds",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet or wok over medium high heat.",
    "Add the chopped onion and cook until it is translucent and starting to caramelize.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the bean sprouts and cook until they are tender but still crisp.",
    "In a small bowl, whisk together the pomegranate molasses, soy sauce, sesame seeds, salt, and black pepper.",
    "Pour the sauce over the bean sprouts and stir to combine.",
    "Cook for an additional 2 minutes, until the sauce has thickened and the bean sprouts are coated.",
    "Remove from heat and serve hot."
  ],
