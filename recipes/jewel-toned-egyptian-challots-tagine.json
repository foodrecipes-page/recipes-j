{
  "title": "Jewel Toned Egyptian Challots Tagine",
  "description": "A spicy and cozy Egyptian dish featuring challots in a glassy-jelly sauce, perfect for a low-glycemic diet.",
  "cuisine": "Egyptian",
  "diet": [
    "low-glycemic",
    "gluten-free"
