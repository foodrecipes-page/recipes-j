  "ingredients": [
    {
      "name": "challots",
      "amount": "4 large",
      "notes": "peeled and sliced"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "ground cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "cayenne pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large saucepan over medium heat.",
    "Add the sliced challots and cook until they are softened and lightly browned.",
    "Add the ground cumin, smoked paprika, cayenne pepper, salt, and black pepper, and cook for 1 minute.",
    "Add the chicken broth and bring the mixture to a boil.",
    "Reduce the heat to low and simmer, covered, for 20 minutes.",
    "Stir in the chopped parsley and lemon juice.",
    "Continue to simmer, uncovered, for an additional 10 minutes, or until the sauce has thickened and the challots are tender.",
    "Serve the tagine hot, garnished with additional parsley if desired."
  ],
