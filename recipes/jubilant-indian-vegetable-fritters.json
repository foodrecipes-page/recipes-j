    {
      "name": "cauliflower",
      "amount": "1 head",
      "notes": "broken into florets"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and grated"
    },
    {
      "name": "onions",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 large",
      "notes": "peeled and diced"
    },
    {
      "name": "vegetable oil",
      "amount": "1 cup"
    },
    {
      "name": "gram flour",
      "amount": "1 cup"
    },
    {
      "name": "garam masala",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "bitter gourd",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "vegetable stock",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Heat the vegetable oil in a deep frying pan to 350 degrees.",
    "In a large bowl, mix together the gram flour, garam masala, and salt.",
    "Add the chopped onions, carrots, potatoes, cauliflower, and bitter gourd to the bowl and mix well.",
    "Gradually add the vegetable stock to the bowl and mix until a thick batter forms.",
    "Using a spoon, drop small amounts of the batter into the hot oil and fry until golden brown.",
    "Remove the fritters from the oil and drain on paper towels.",
    "Serve the fritters hot with a side of vegetable stock.",
    "Garnish with chopped fresh cilantro, if desired."
  ],
