{
  "title": "Juicy Buttery Festive Vietnamese Stir-fry",
  "description": "This buttery and juicy festive dish features dried cherries in a savory sauce that's perfect for a light dinner or snack.",
  "cuisine": "Vietnamese",
  "diet": [
    "buttery",
