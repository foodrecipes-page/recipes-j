      "amount": "4 large",
      "notes": "peeled and chopped"
    },
    {
      "name": "double-rise-bread",
      "amount": "1 loaf",
      "notes": "crumbs only"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "finely chopped"
    },
    {
      "name": "garlic-free seasoning",
      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1/2 tsp"
    },
    {
