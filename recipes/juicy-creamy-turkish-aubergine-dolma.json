      "amount": "1/4 tsp"
    },
    {
      "name": "plain yogurt",
      "amount": "1 cup"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lemon juice",
      "amount": "2 tbsp"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large skillet, heat the olive oil over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the chopped aubergine and cook until tender, about 10 minutes.",
    "In a large bowl, combine the cooked aubergine mixture, double-rise-bread crumbs, garlic-free seasoning, salt, and black pepper.",
    "Stuff each aubergine shell with the bread mixture and place in a baking dish.",
    "In a small bowl, mix the plain yogurt, chopped parsley, and lemon juice.",
    "Pour the yogurt mixture over the stuffed aubergine and bake for 25 minutes.",
    "Serve warm and enjoy."
  ],
