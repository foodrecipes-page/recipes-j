  "ingredients": [
    {
      "name": "boneless chicken thighs",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "szechuan peppercorns",
      "amount": "2 teaspoons",
      "notes": "toasted and ground"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "dried apricots",
      "amount": "1/2 cup",
      "notes": "chopped"
    },
    {
      "name": "chicken broth",
      "amount": "1 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in the ttukbaegi earthenware pot over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the chicken pieces and cook until they are browned on all sides.",
    "Add the toasted and ground szechuan peppercorns, salt, and black pepper, and stir to combine.",
    "Add the chicken broth, dried apricots, and butter, and bring to a boil.",
    "Reduce the heat to low, cover the pot, and simmer for 30 minutes.",
    "Serve the tagine hot, garnished with chopped fresh parsley or cilantro.",
    "Let it rest for 10 minutes before serving.",
    "Serve with couscous or rice.",
    "Garnish with lemon wedges."
  ],
