{
  "title": "Jewel Toned Kenyan Lamb Stew",
  "description": "A citrusy and flavorful one-pot Kenyan dish featuring lamb shoulder, with a glassy-jelly texture, made lacto-vegetarian-friendly by using shio-cure and omitting non-vegetarian ingredients.",
  "cuisine": "Kenyan",
  "diet": [
    "lacto-vegetarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1.5 pounds",
      "notes": "cut into 2 inch pieces"
    },
    {
      "name": "shio cure",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "1/4 cup"
    },
    {
      "name": "orange juice",
      "amount": "1/4 cup"
    },
    {
      "name": "ginger",
      "amount": "2 inches",
      "notes": "grated"
    },
    {
      "name": "garlic",
      "amount": "4 cloves",
      "notes": "minced"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "agave nectar",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Heat the oil in a large pot over medium heat.",
    "Add the lamb and cook until browned on all sides.",
    "Add the shio cure, lemon juice, orange juice, ginger, and garlic, and stir to combine.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 2 hours.",
    "Stir in the agave nectar and salt.",
    "Continue to simmer for another 30 minutes, or until the lamb is tender and the sauce has thickened.",
    "Remove the pot from the heat and let it cool slightly.",
    "Serve the stew hot, garnished with fresh herbs if desired."
  ],
