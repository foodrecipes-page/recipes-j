{
  "title": "Juicy Russian Bread Toast",
  "description": "A kid-friendly Russian dish featuring toasted bread topped with a plant-based mixture of sauerkraut and vegetables, perfect for a quick snack.",
  "cuisine": "Russian",
  "diet": [
    "vegetarian",
    "vegan"
  ],
  "meal": "snack",
  "ingredients": [
    {
      "name": "Russian black bread",
      "amount": "1 loaf",
      "notes": "preferably a day-old bread"
    },
    {
      "name": "sauerkraut",
      "amount": "1 cup",
      "notes": "drained and rinsed"
    },
    {
      "name": "carrots",
      "amount": "1 cup",
      "notes": "grated"
    },
    {
      "name": "onions",
      "amount": "1/2 cup",
      "notes": "finely chopped"
    },
    {
      "name": "vegan mayonnaise",
      "amount": "1/4 cup"
    },
    {
      "name": "dill",
      "amount": "1 tablespoon",
      "notes": "chopped fresh"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat the oven to 350 degrees Fahrenheit.",
    "Slice the Russian black bread into 1-inch thick slices and toast until lightly browned.",
    "In a large bowl, mix together the sauerkraut, carrots, onions, vegan mayonnaise, dill, salt, and black pepper.",
    "Brush the toasted bread slices with olive oil.",
    "Top each toasted bread slice with a spoonful of the sauerkraut mixture.",
    "Serve immediately and enjoy.",
    "Store any leftovers in an airtight container in the refrigerator for up to 24 hours.",
    "Reheat the toast in the oven at 300 degrees Fahrenheit for 5 minutes before serving."
  ],
