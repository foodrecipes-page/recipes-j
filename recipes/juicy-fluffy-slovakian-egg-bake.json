{
  "title": "Juicy Fluffy Slovakian Egg Bake",
  "description": "A high protein friendly Slovakian dish featuring dill and eggs, perfect for a brunch mood. This herbal and fluffy bake is sure to satisfy your appetite.",
  "cuisine": "Slovakian",
  "diet": [
    "high protein",
    "gluten free"
  ],
  "meal": "breakfast",
  "ingredients": [
    {
      "name": "eggs",
      "amount": "6 large",
      "notes": "fresh"
    },
    {
      "name": "dill",
      "amount": "1/4 cup",
      "notes": "chopped fresh"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbly"
    },
    {
      "name": "milk",
      "amount": "1 cup",
      "notes": "low fat"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon",
      "notes": "none"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon",
      "notes": "none"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons",
      "notes": "melted"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, whisk together the eggs, milk, salt, and black pepper until well combined.",
    "Stir in the chopped dill and crumbly feta cheese.",
    "Pour the egg mixture into a greased 9x13 inch baking dish.",
    "Drizzle the melted butter over the top of the egg mixture.",
    "Bake for 25-30 minutes or until the eggs are set and the top is golden brown.",
    "Remove from the oven and let cool for a few minutes before serving.",
    "Slice into squares and serve hot."
  ],
