      "amount": "4 large"
    },
    {
      "name": "shredded cheese",
      "amount": "1 cup",
      "notes": "monterey jack"
    },
    {
      "name": "chopped fresh parsley",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the iron teppan to medium heat",
    "Add olive oil and saute the diced onion until translucent",
    "Add minced garlic and cook for 1 minute",
    "Add smoked paprika and cook for 30 seconds",
    "In a large bowl whisk the eggs and season with salt and pepper",
    "Pour the egg mixture over the onion mixture in the teppan",
    "Cook until the eggs start to set",
    "Place a tortilla in the teppan and sprinkle shredded cheese on half of the tortilla",
    "Fold the tortilla in half to enclose the cheese",
    "Cook for 2 minutes and flip the quesadilla",
    "Cook for an additional 2 minutes and slice into wedges",
    "Garnish with chopped fresh parsley and serve hot"
  ],
