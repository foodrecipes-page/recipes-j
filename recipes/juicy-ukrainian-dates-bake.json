    },
    {
      "name": "black pepper",
      "amount": "1/4 tsp",
      "notes": "optional"
    },
    {
      "name": "fresh dill",
      "amount": "2 tbsp",
      "notes": "chopped, for garnish"
    }
  ],
  "instructions": [
    "Preheat oven to 180C.",
    "Heat 1 tbsp olive oil in a skillet over medium heat and sauté the diced potatoes until slightly golden, about 5 minutes.",
    "Add carrots and cabbage to the skillet, cook for another 4 minutes until softened.",
    "Stir in the pitted dates, dried dill, parsley, thyme, salt, pepper, and vegetable broth, and simmer for 3 minutes.",
    "Transfer the mixture to a greased baking dish, drizzle remaining 1 tbsp olive oil over the top.",
    "Bake uncovered for 25 minutes until vegetables are tender and the liquid has reduced.",
    "Remove from oven, sprinkle chopped fresh dill on top, and let rest for 5 minutes before serving.",
    "Serve warm as a light, herbal dinner side or main."
  ],
