{
  "title": "Juicy Ukrainian Dates Bake",
  "description": "A fragrant, sweet-savory bake with dates, herbs and tender vegetables, perfect for a quick weeknight meal.",
  "cuisine": "Ukrainian",
  "diet": [
    "vegetarian"
  ],
  "meal": "dinner",
  "ingredients": [
