  "ingredients": [
    {
      "name": "fideua noodles",
      "amount": "1 cup",
      "notes": "Spanish pasta"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "unsalted butter",
      "amount": "4 tablespoons"
    },
    {
      "name": "fish sauce",
      "amount": "1/4 cup"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    },
    {
      "name": "cod fillets",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large Dutch oven over medium heat.",
    "Add the butter and let it melt, then add the fish sauce and stir to combine.",
    "Add the fideua noodles and cook for 2 minutes, stirring constantly.",
    "Add the chicken broth, cod fillets, lemon juice, paprika, salt, and black pepper, and stir to combine.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 10 minutes.",
    "Stir the fideua occasionally to prevent it from sticking to the bottom of the pot.",
    "After 10 minutes, remove the pot from the heat and let it rest for 2 minutes.",
    "Serve the fideua hot, garnished with chopped fresh parsley if desired."
  ],
