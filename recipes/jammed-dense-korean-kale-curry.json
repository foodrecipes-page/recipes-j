{
  "title": "Jammed Dense Korean Kale Curry",
  "description": "A pungent and dense Korean curry dish featuring kale, made in a kadhai and inspired by Gyeongsang cuisine, with a Mediterranean twist",
  "cuisine": "Korean",
  "diet": [
    "vegetarian"
  ],
