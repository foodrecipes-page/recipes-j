      "amount": "1 medium"
    },
    {
      "name": "garlic",
      "amount": "3 cloves"
    },
    {
      "name": "puff pastry",
      "amount": "1 package"
    },
    {
      "name": "egg",
      "amount": "1 large"
    },
    {
      "name": "sour cream",
      "amount": "1/2 cup"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat oven to 375 degrees.",
    "In a large skillet, cook the pork shoulder over medium heat until browned.",
    "Add the onion and garlic to the skillet and cook until the onion is translucent.",
    "In a large bowl, combine the cooked pork, sour cream, paprika, salt, and pepper.",
    "Roll out the puff pastry and place the pork mixture in the center.",
    "Brush the edges of the pastry with the egg and fold the pastry over the filling.",
    "Place the pie on a baking sheet and bake for 25 minutes.",
    "Reduce the oven temperature to 350 degrees and continue baking for an additional 10 minutes.",
    "Let the pie rest for 5 minutes before serving."
  ],
