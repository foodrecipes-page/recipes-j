  "ingredients": [
    {
      "name": "butternut squash",
      "amount": "1 large",
      "notes": "peeled and cubed"
    },
    {
      "name": "nuka-pickle",
      "amount": "1/2 cup",
      "notes": "finely chopped"
    },
    {
      "name": "brown rice flour",
      "amount": "2 tablespoons",
      "notes": "for thickening"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons",
      "notes": "for saut\u00023ing"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "apple cider vinegar",
      "amount": "2 tablespoons",
      "notes": "for flavor"
    },
    {
      "name": "maple syrup",
      "amount": "1 tablespoon",
      "notes": "for sweetness"
    }
  ],
  "instructions": [
    "preheat oven to 375\u00110f",
    "saute the onion and garlic in olive oil until softened",
    "add the cubed butternut squash and cook until tender",
    "stir in the chopped nuka-pickle, brown rice flour, and apple cider vinegar",
    "transfer the mixture to a baking dish and top with a drizzle of maple syrup",
    "bake for 20 minutes or until the cass-role is golden brown",
    "serve hot and garnish with chopped fresh herbs"
  ],
