{
  "title": "juicy sweet polish butternut squash cass-role",
  "description": "a winey, juicy, kid-friendly polish dish featuring butternut squash, nuka-pickle, and ayurvedic-tamasic-friendly ingredients",
  "cuisine": "polish",
  "diet": [
    "vegetarian"
  ],
