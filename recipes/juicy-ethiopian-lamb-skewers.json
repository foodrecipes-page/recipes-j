      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "Asian chive",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "yuzu juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Preheat the raclette grill to 400 degrees Fahrenheit",
    "In a large bowl, whisk together yuzu juice, butter, garlic, ginger, black pepper, and salt",
    "Add the lamb cubes to the bowl and marinate for at least 30 minutes",
    "Thread the marinated lamb cubes onto skewers, leaving a small space between each cube",
    "Brush the skewers with olive oil and sprinkle with chopped Asian chive",
    "Place the skewers on the raclette grill and cook for 10 minutes per side",
    "Serve the skewers hot, garnished with additional Asian chive if desired"
  ],
