      "name": "iceberg lettuce",
      "amount": "2 heads",
      "notes": "chopped"
    },
    {
      "name": "gochujang",
      "amount": "1/4 cup"
    },
    {
      "name": "soy sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "tofu",
      "amount": "1 block",
      "notes": "diced"
    },
    {
      "name": "sesame oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the sesame oil in a ttukbaegi earthenware pot over medium heat.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the chopped iceberg lettuce and cook until wilted, about 5 minutes.",
    "Add the gochujang, soy sauce, and diced tofu, stirring to combine.",
    "Bring the mixture to a simmer and cook for 10 minutes.",
    "Season with salt and pepper to taste.",
    "Garnish with chopped scallions and serve hot.",
    "Let the stew cool, then refrigerate overnight to allow the flavors to meld.",
    "Reheat the stew over low heat before serving."
  ],
