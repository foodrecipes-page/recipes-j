  "ingredients": [
    {
      "name": "chicken thighs",
      "amount": "1 1/2 pounds",
      "notes": "boneless and skinless"
    },
    {
      "name": "tahini paste",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "dried thyme",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    },
    {
      "name": "malt vinegar",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit.",
    "Season the chicken thighs with salt, black pepper, and dried thyme.",
    "Heat the olive oil in the clay pot over medium heat.",
    "Sear the chicken thighs until browned on all sides, then set aside.",
    "Add the chopped onion to the clay pot and cook until softened.",
    "Add the minced garlic to the clay pot and cook for 1 minute.",
    "Stir in the tahini paste and cook for 1 minute.",
    "Add the chicken broth, malt vinegar, and browned chicken thighs to the clay pot.",
    "Cover the clay pot and transfer to the preheated oven.",
    "Bake for 30 minutes or until the chicken is cooked through."
  ],
