    },
    {
      "name": "rice wine vinegar",
      "amount": "1/2 cup"
    },
    {
      "name": "binchotan charcoal",
      "amount": "1 piece",
      "notes": "for smoking"
    },
    {
      "name": "walnuts",
      "amount": "1 cup",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1 tsp"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit",
    "Place the red bell peppers on a baking sheet and roast for 30 minutes",
    "Remove the peppers from the oven and let them cool",
    "Peel the skin off the peppers and place them in a blender",
    "Add the rice wine vinegar, walnuts, garlic, salt, and black pepper to the blender",
    "Blend the mixture until it is smooth",
    "Heat the olive oil in a pan over medium heat",
    "Add the blended pepper mixture to the pan and stir constantly",
    "Smoke the mixture with binchotan charcoal for 5 minutes",
    "Serve the muhammara warm"
  ],
