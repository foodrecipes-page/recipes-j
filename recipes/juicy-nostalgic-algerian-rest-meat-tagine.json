  "instructions": [
    "heat olive oil in a large Dutch oven over medium heat.",
    "add onion and cook until softened, about 5 minutes.",
    "add garlic and ginger and cook for 1 minute.",
    "add rest-meat and cook until browned, breaking into small pieces as it cooks.",
    "add cumin, coriander, paprika, salt, and black pepper.",
    "stir in salted butter until melted.",
    "add 1 cup of water and bring to a boil.",
    "reduce heat to low and simmer, covered, for 1 hour and 15 minutes.",
    "stir in chopped parsley.",
    "serve hot over couscous or rice."
