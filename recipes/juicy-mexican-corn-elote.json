  "instructions": [
    "Preheat grill to 375 degrees Fahrenheit.",
    "Husk the corn and remove the silk.",
    "In a large bowl, mix together coconut cream, score-fat, lime juice, salt, pepper, and garlic powder.",
    "Brush the mixture onto each ear of corn.",
    "Wrap each ear of corn in a banana leaf.",
    "Grill the corn for 20 minutes, turning every 5 minutes.",
    "Remove the corn from the grill and let it cool for 5 minutes.",
    "Serve the corn hot, still wrapped in the banana leaf."
  ],
