      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "tahini",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "Roast the eggplant for 30 minutes, or until it is tender and collapsed.",
    "Let the eggplant cool, then scoop out the flesh and transfer it to a blender.",
    "Add the mustard seeds, beurre-monte, lemon juice, garlic, salt, and black pepper to the blender.",
    "Blend the mixture until it is smooth and creamy.",
    "Stir in the tahini.",
    "Taste and adjust the seasoning as needed.",
    "Transfer the baba ganoush to a serving bowl and garnish with parsley or cilantro.",
    "Serve the baba ganoush with pita bread or vegetables."
  ],
