  "instructions": [
    "heat the olive oil in a large paella pan over medium-high heat.",
    "add the garlic and cook for 1-2 minutes until fragrant.",
    "add the gambas and cook until pink and just set.",
    "add the smoked paprika and cook for 1 minute.",
    "add the chicken broth and bring to a boil.",
    "reduce heat to low and simmer for 10-12 minutes.",
    "stir in the pasta water and sherry vinegar.",
    "add the diced tomato and cook for an additional 2-3 minutes.",
    "stir in the graham cracker crumbs and cook for 1 minute.",
    "season with salt and black pepper to taste.",
    "serve immediately and enjoy."
  ],
