      "name": "duck breast",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "soda water",
      "amount": "1 cup"
    },
    {
      "name": "infuse oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "thyme",
      "amount": "1 tablespoon",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat.",
    "In a large bowl, whisk together soda water, infuse oil, lemon juice, garlic, thyme, salt, and black pepper.",
    "Add the duck breast pieces to the bowl and marinate for at least 30 minutes.",
    "Thread the marinated duck pieces onto skewers.",
    "Grill the skewers for 10-12 minutes, or until the duck is cooked through.",
    "Let the skewers rest for 5 minutes before serving.",
    "Serve the skewers hot, garnished with additional thyme if desired."
  ],
