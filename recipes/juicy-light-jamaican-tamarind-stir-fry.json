      "notes": ""
    },
    {
      "name": "2 tbsp tamarind paste",
      "amount": "",
      "notes": ""
    },
    {
      "name": "1/4 cup granulated sugar",
      "amount": "",
      "notes": ""
    },
    {
      "name": "Pinch of salt",
      "amount": "",
      "notes": ""
    },
    {
      "name": "2 tbsp cornstarch",
      "amount": "",
      "notes": ""
    },
    {
      "name": "1/2 tsp ground cloves",
      "amount": "",
      "notes": ""
    },
    {
      "name": "1/4 cup water",
      "amount": "",
      "notes": ""
    },
    {
      "name": "Cooked white rice, optional garnish",
      "amount": "",
      "notes": ""
    }
  ],
  "instructions": [
    "In a small saucepan, combine the tamarind paste and sugar. Gradually stir in the coconut milk until smooth.",
    "Heat over medium-low for about 5 minutes, stirring occasionally to prevent scorching and ensure even cooking of the ingredients.",
    "Stir in the cornstarch mixture until well combined, then add the water and bring back to a simmer. Cook for an additional 2-3 minutes or until thickened.",
    "Season with salt and cloves to taste. Serve hot over cooked white rice if desired."
  ],
