    },
    {
      "name": "black pepper",
      "amount": "1/4 tsp",
      "notes": "freshly ground"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "Heat the olive oil in a large cast-iron skillet over medium heat.",
    "Add the garlic powder and shio-koji-cure to the skillet and cook for 1 minute.",
    "Add the canned crushed tomatoes to the skillet and stir to combine.",
    "Bring the tomato mixture to a simmer and cook for 10 minutes.",
    "Create 6 wells in the tomato mixture and crack an egg into each well.",
    "Season the eggs with salt and black pepper to taste.",
    "Transfer the skillet to the preheated oven and bake for 15 minutes.",
    "Remove the skillet from the oven and sprinkle the feta cheese over the top.",
    "Serve the shakshuka hot with pita bread on the side."
  ],
