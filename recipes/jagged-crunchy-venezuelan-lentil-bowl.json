    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "crushed plantain chips",
      "amount": "1/2 cup",
      "notes": "for garnish"
    }
  ],
  "instructions": [
    "Rinse the French lentils and cook them in boiling water for 20 minutes or until they are tender.",
    "In a pan, heat the olive oil over medium heat and saute the chopped onion until it is translucent.",
    "Add the minced garlic, cumin, smoked paprika, salt, and black pepper to the pan and cook for 1 minute.",
    "Stir in the ferment-jang and cook for an additional 2 minutes.",
    "Combine the cooked lentils and the ferment-jang mixture in a bowl.",
    "Garnish with crushed plantain chips and serve in a bamboo tray.",
    "Let it cool for a few minutes before serving.",
    "Serve immediately and enjoy.",
    "You can store any leftovers in an airtight container in the refrigerator for up to 3 days."
  ],
