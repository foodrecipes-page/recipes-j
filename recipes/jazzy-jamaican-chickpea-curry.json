      "amount": "2 tablespoons"
    },
    {
      "name": "coconut oil",
      "amount": "1/4 cup"
    },
    {
      "name": "agave nectar",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the coconut oil in the agave leaf vessel over medium heat.",
    "Add the chopped onion and saute until it is translucent and starting to caramelize.",
    "Add the minced garlic and grated ginger and saute for another minute.",
    "Stir in the jamaican curry powder and cook for 1 minute.",
    "Add the chickpeas, agave nectar, salt, and black pepper, and stir to combine.",
    "Pressure cook the mixture for 10 minutes.",
    "Stir in the grated parmigiano-reggiano.",
    "Serve the curry hot, garnished with chopped fresh herbs if desired."
  ],
