      "amount": "2 cups, finely chopped"
    },
    {
      "name": "bell peppers",
      "amount": "4 medium, sliced thinly"
    },
    {
      "name": "garlic cloves",
      "amount": "5, minced"
    },
    {
      "name": "sesame oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "soy sauce",
      "amount": "3 tablespoons"
    },
    {
      "name": "rice vinegar",
      "amount": "2 tablespoons"
    },
    {
      "name": "sugar-free sweetener (optional)",
      "amount": "to taste"
    }
  ],
  "instructions": [
    "Preheat a wok or large skillet over medium-high heat. Add sesame oil and sauté onions until translucent.",
    "Add finely chopped green olives, sliced bell peppers, and minced garlic to the pan. Stir-fry for about 5 minutes or until vegetables are tender.",
    "In a small bowl, mix soy sauce, rice vinegar, and sweetener (if using) together. Pour this mixture over the stir-fried vegetables.",
    "Stir everything well and cook for another minute. Serve hot as a snack."
