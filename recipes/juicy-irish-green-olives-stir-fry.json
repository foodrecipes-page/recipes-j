{
  "title": "Floral Juicy Irish Green Olives Stir-fry",
  "description": "A kid-friendly and floral-flavored dish featuring juicy green olives in a savory stir-fry that is sugar-free friendly.",
  "cuisine": "Irish",
  "diet": null,
