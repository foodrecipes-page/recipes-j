      "amount": "1 pound",
      "notes": "cut into bite-sized pieces"
    },
    {
      "name": "iceberg lettuce",
      "amount": "1 head",
      "notes": "leaves separated"
    },
    {
      "name": "brine",
      "amount": "1 cup",
      "notes": "for marinating"
    },
    {
      "name": "jelly",
      "amount": "1 cup",
      "notes": "homemade or store-bought"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup",
      "notes": "for brushing"
    },
    {
