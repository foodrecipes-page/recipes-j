    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the iron-teppan to 400 degrees Fahrenheit.",
    "Roll out the phyllo dough to a large sheet.",
    "Layer the pancetta, feta cheese, and parsley on one half of the dough.",
    "Fold the other half of the dough over the filling to form a triangle.",
    "Brush the edges with olive oil and press to seal.",
    "Place the borek on the preheated iron-teppan and cook for 10 minutes.",
    "Flip the borek and cook for an additional 10 minutes.",
    "Serve the borek in a stone-bowl-dolsot and enjoy."
  ],
