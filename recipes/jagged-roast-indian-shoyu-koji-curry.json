  "instructions": [
    "heat the coconut oil in the iron teppan over medium-high heat",
    "add the onion and cook until slightly browned, about 5 minutes",
    "add the garlic and ginger and cook for 1 minute",
    "add the tomato and cook until tender, about 3 minutes",
    "add the turmeric, cumin, coriander, cayenne pepper, salt, and black pepper and cook for 1 minute",
    "add the shoyu-koji and cook for 2 minutes, stirring constantly",
    "add the coconut milk and water and bring to a boil",
    "reduce the heat to low and simmer for 10 minutes",
    "add the roast eggplant and cook for 2 minutes",
    "garnish with fresh cilantro and serve"
