      "name": "1 medium head of cabbage",
      "amount": "1",
      "notes": ""
    },
    {
      "name": "2 tablespoons of amlou paste",
      "amount": "2",
      "notes": "store-bought or homemade"
    },
    {
      "name": "1/4 cup of olive oil",
      "amount": "1/4",
      "notes": ""
    },
    {
      "name": "1 teaspoon of ground cumin",
      "amount": "1",
      "notes": ""
    },
    {
      "name": "1 teaspoon of smoked paprika",
      "amount": "1",
      "notes": ""
    },
    {
      "name": "1/2 teaspoon of salt",
      "amount": "1/2",
      "notes": ""
    },
    {
      "name": "1/4 teaspoon of black pepper",
      "amount": "1/4",
      "notes": ""
    },
    {
      "name": "2 cloves of garlic",
      "amount": "2",
      "notes": "minced"
    },
    {
      "name": "1 small red onion",
      "amount": "1",
      "notes": "thinly sliced"
    },
    {
      "name": "1/4 cup of chopped cilantro",
      "amount": "1/4",
      "notes": ""
    }
  ],
  "instructions": [
    "preheat a grill to medium-high heat",
    "cut the cabbage into wedges and brush with olive oil",
    "place the cabbage on the grill and cook for 5 minutes per side, or until slightly charred",
    "while the cabbage is cooking, heat the amlou paste in a small saucepan over medium heat",
    "add the cumin, smoked paprika, salt, and black pepper to the saucepan and stir to combine",
    "add the minced garlic and cook for 1 minute",
    "add the sliced red onion to the saucepan and cook for an additional 2 minutes",
    "remove the cabbage from the grill and place it in a clay tajine",
    "pour the amlou paste mixture over the cabbage and top with chopped cilantro",
    "cover the tajine with a lid and let it rest for 5 minutes before serving"
  ],
