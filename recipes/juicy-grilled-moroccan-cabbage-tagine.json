{
  "title": "juicy grilled moroccan cabbage tagine",
  "description": "a crispy, flavorful and satisfying solo dinner featuring grilled cabbage in a moroccan-inspired tajine with a rich amlou paste",
  "cuisine": "mexican-moroccan-fusion",
