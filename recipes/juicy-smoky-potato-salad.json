{
  "title": "Juicy Smoky Potato Salad",
  "description": "This earthy and juicy potato salad features smoked paprika for an added smokiness. Perfect as a post-workout meal with its raw-friendly nature.",
  "cuisine": "Ukrainian",
  "diet": [
    "vegetarian",
    "low-carb"
  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "Potatoes",
      "amount": "2 lbs (900g) small Yukon Gold potatoes"
    },
    {
      "name": "Paprika",
      "amount": "1 tbsp smoked paprika"
    },
    {
      "name": "Onion",
      "amount": "1/4 cup finely chopped"
    },
    {
      "name": "Red Bell Pepper",
      "amount": "1/2 cup sliced thinly"
    },
    {
      "name": "Capers",
      "amount": "3 tbsp (about 10 pcs) rinsed and pitted"
    },
    {
      "name": "Olives",
      "amount": "2 cups pitted Kalamata olives"
    },
    {
      "name": "Mayonnaise",
      "amount": "4 tbsp"
    },
    {
      "name": "Lemon Juice",
      "amount": "2 tbsp fresh lemon juice (optional)"
    },
    {
      "name": "Salt",
      "amount": "to taste"
    },
    {
      "name": "Black Pepper",
      "amount": "to taste"
    }
  ],
  "instructions": [
    "Preheat oven to 400°F (200°C).",
    "Slice potatoes into thin rounds.",
    "Drizzle with olive oil, sprinkle paprika over potatoes, and toss to coat evenly. Place on a baking sheet lined with parchment paper.",
    "Roast for about 15-20 minutes until golden brown and tender. Allow to cool slightly.",
    "In a large bowl, combine cooled roasted potatoes, finely chopped onion, sliced red bell pepper, rinsed capers, pitted olives, mayonnaise, lemon juice (if using), salt, and black pepper. Mix well.",
    "Garnish with fresh herbs if desired."
  ],
