{
  "title": "Jagged American Feta Wrap",
  "description": "A vegan-friendly post-workout dish featuring cubed feta cheese and a corn husk wrap, with an al-dente finish and a fermented, crumbly texture.",
  "cuisine": "American",
  "diet": [
    "gluten-free"
  ],
