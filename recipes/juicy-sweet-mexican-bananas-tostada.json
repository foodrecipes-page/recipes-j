{
  "title": "Juicy Sweet Mexican Bananas Tostada",
  "description": "A nostalgic Mexican dish from Chiapas featuring fried ripe bananas, lardons-render, and a diabetic-friendly twist, served on a tostada, perfect for a snack or dessert",
  "cuisine": "Mexican",
  "diet": [
    "diabetic-friendly",
    "gluten-free"
  ],
  "meal": "dessert",
  "ingredients": [
    {
      "name": "ripe bananas",
      "amount": "4",
      "notes": "sliced into 1-inch rounds"
    },
    {
      "name": "lardons",
      "amount": "6",
      "notes": "crispy fried"
    },
    {
      "name": "cinnamon sugar",
      "amount": "1/4 cup",
      "notes": "mixed"
    },
    {
      "name": "tostada shells",
      "amount": "4",
      "notes": "fried until crispy"
    },
    {
      "name": "honey",
      "amount": "2 tbsp",
      "notes": "drizzled on top"
    },
    {
      "name": "whipped cream",
      "amount": "1 cup",
      "notes": "optional"
    }
  ],
  "instructions": [
    "Heat the lardons in a pan over medium heat until crispy and golden brown",
    "In a separate pan, heat the cinnamon sugar over low heat, stirring constantly",
    "Add the sliced bananas to the cinnamon sugar pan and cook for 2-3 minutes on each side, until caramelized",
    "Fry the tostada shells in hot oil until crispy and golden brown",
    "Assemble the tostadas by placing a few slices of the caramelized bananas on each shell",
    "Drizzle the honey on top of the bananas",
    "Sprinkle the crispy lardons over the honey",
    "Top with whipped cream, if desired",
    "Serve immediately and enjoy"
  ],
