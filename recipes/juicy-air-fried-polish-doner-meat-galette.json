{
  "title": "Juicy Air-Fried Polish Doner Meat Galette",
  "description": "A pescatarian-friendly Polish-inspired dish featuring air-fried doner meat, served in a mason jar with a jammy and flaky crust.",
  "cuisine": "Polish",
  "diet": null,
  "meal": "lunch",
  "ingredients": [
    {
      "name": "all-purpose flour",
      "amount": "1 1/2 cups"
    },
    {
      "name": "cold unsalted butter",
      "amount": "1/2 cup"
    },
    {
      "name": "ice water",
      "amount": "1/4 cup",
      "notes": "as needed"
    },
    {
      "name": "sour cream",
      "amount": "1/4 cup"
    },
    {
      "name": "doner meat",
      "amount": "12 oz"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "thinly sliced"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "chopped fresh dill",
      "amount": "1 tablespoon"
    },
    {
      "name": "lemon juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "beaten egg",
      "amount": "1 large"
    }
  ],
  "instructions": [
    "Preheat the air fryer to 375°F.",
    "In a large bowl, combine flour, cold butter, and ice water. Mix until dough forms, and then knead for 5 minutes.",
    "Roll out the dough to a thickness of 1/8 inch and transfer to a mason jar.",
    "In a pan over medium heat, cook the doner meat, onion, and garlic until the onion is translucent.",
    "Stir in sour cream, dill, lemon juice, salt, and black pepper.",
    "Spoon the doner meat mixture into the dough-lined mason jar.",
    "Cover the filling with the dough and press the edges to seal.",
    "Brush the top of the galette with beaten egg and air-fry for 15 minutes, or until golden brown.",
    "Let the galette cool for 5 minutes before serving."
  ],
