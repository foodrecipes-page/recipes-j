  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1 1/2 inch cubes"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "carrots",
      "amount": "2 large",
      "notes": "peeled and chopped"
    },
    {
      "name": "celery",
      "amount": "2 stalks",
      "notes": "chopped"
    },
    {
      "name": "dill",
      "amount": "1/4 cup",
      "notes": "fresh and chopped"
    },
    {
      "name": "smoked paprika",
      "amount": "2 tablespoons"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "lamb broth",
      "amount": "2 cups"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large Dutch oven over medium-high heat.",
    "Add the lamb cubes and cook until browned on all sides, about 5 minutes.",
    "Add the chopped onion, carrots, and celery and cook until the vegetables are tender, about 8 minutes.",
    "Add the smoked paprika, tomato paste, and dill, and cook for 1 minute, stirring constantly.",
    "Add the lamb broth and bring the mixture to a boil.",
    "Reduce the heat to low and simmer, covered, for 1 1/2 hours, or until the lamb is tender.",
    "Season the stew with salt and pepper to taste.",
    "Serve the stew hot, garnished with additional dill if desired."
  ],
