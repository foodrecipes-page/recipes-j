{
  "title": "Juicy Egyptian Peas Curry",
  "description": "A creamy, aromatic curry featuring frozen peas, vibrant spices, and a smoky tandoori finish, perfect for a lazy Sunday meal.",
  "cuisine": "Egyptian",
