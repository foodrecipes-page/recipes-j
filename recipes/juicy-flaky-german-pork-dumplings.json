  "ingredients": [
    {
      "name": "pork shoulder",
      "amount": "1 pound",
      "notes": "ground"
    },
    {
      "name": "tamarind paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "all-purpose flour",
      "amount": "1 cup"
    },
    {
      "name": "butter",
      "amount": "1/4 cup",
      "notes": "melted"
    },
    {
      "name": "egg",
      "amount": "1 large"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "finely chopped"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the sous-vide machine to 180 degrees Fahrenheit",
    "In a large bowl, combine the ground pork, tamarind paste, flour, melted butter, egg, onion, garlic, salt, and black pepper",
    "Mix the ingredients until just combined, being careful not to overmix",
    "Divide the mixture into 8 equal pieces and shape each piece into a ball",
    "Flatten each ball into a disk shape",
    "Place the dumplings in a single layer in a sous-vide bag",
    "Seal the bag and cook the dumplings for 2 hours",
    "Remove the dumplings from the bag and serve hot"
  ],
