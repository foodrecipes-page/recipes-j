      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "grana padano cheese",
      "amount": "1/2 cup",
      "notes": "shaved"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
