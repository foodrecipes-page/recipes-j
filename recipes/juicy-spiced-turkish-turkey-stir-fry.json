    },
    {
      "name": "soy sauce",
      "amount": "2 tbsp"
    },
    {
      "name": "red curry paste",
      "amount": "1 tsp"
    },
    {
      "name": "ground cumin",
      "amount": "1/2 tsp"
    },
    {
      "name": "cloves of garlic, minced",
      "amount": "4 cloves"
    },
    {
      "name": "paleo-friendly rice vinegar",
      "amount": "2 tbsp"
    },
    {
      "name": "fresh lemon juice",
      "amount": "2 tbsp"
    },
    {
      "name": "turmeric powder",
      "amount": "1/2 tsp"
    },
    {
      "name": "coconut milk",
      "amount": "30ml (2 oz)"
    },
    {
      "name": "paleo-friendly breadcrumbs",
      "amount": "1/4 cup"
    },
    {
      "name": "ground black pepper",
      "amount": "1/4 tsp"
    }
  ],
  "instructions": [
    "Preheat oven to 180°C (350°F).",
    "Mix soy sauce, curry paste, cumin, minced garlic, rice vinegar, lemon juice, turmeric powder, and coconut milk in a large mixing bowl.",
    "Coat turkey breast with paleo-friendly breadcrumbs. Add coated turkey to the bowl with marinade. Mix thoroughly and set aside for 20 minutes.",
    "Place turkey on a baking sheet lined with parchment paper. Bake for 35-45 minutes until golden brown and cooked through (internal temperature of 74°C or 165°F).",
    "Once done, reduce the oven heat to 150°C (300°F) and bake for an additional 20-30 minutes.",
    "Garnish with fresh herbs if desired."
