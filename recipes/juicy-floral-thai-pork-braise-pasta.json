{
  "title": "Juicy Floral Thai Pork Braise Pasta",
  "description": "A sweet and savory Thai-inspired pasta dish featuring paccheri pasta, slow-cooked pork, and fragrant floral notes.",
  "cuisine": "Thai",
  "diet": [
    "sugar-free",
    "pork"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "paccheri pasta",
      "amount": "8 oz (225g)"
    },
    {
      "name": "pork shoulder",
      "amount": "1 lb (450g)",
      "notes": "cut into 2-inch (5 cm) pieces"
    },
    {
      "name": "coconut oil",
      "amount": "2 tbsp (30ml)"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "thinly sliced"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "fish sauce",
      "amount": "2 tbsp (30ml)"
    },
    {
      "name": "Thai red curry paste",
      "amount": "2 tbsp (30g)"
    },
    {
      "name": "lemon juice",
      "amount": "2 tbsp (30ml)"
    },
    {
      "name": "honey",
      "amount": "1 tsp (5g)"
    },
    {
      "name": "Thai basil",
      "amount": "1/4 cup (10g)"
    },
    {
      "name": "Kaffir lime leaves",
      "amount": "4-6",
      "notes": "fresh or dried"
    },
    {
      "name": "salt",
      "amount": "to taste"
    }
  ],
  "instructions": [
    "Heat oil in a large Dutch oven over medium-high. Sear pork until browned, then remove.",
    "Add onion to pot, cooking until softened. Add garlic and cook 1 minute.",
    "Add curry paste and cook 1 minute, stirring constantly.",
    "Add fish sauce, lemon juice, and honey. Bring to a simmer.",
    "Add pork back to pot, cover, and transfer to oven (375°F / 190°C). Braise 2 hours or until tender.",
    "Add paccheri pasta to the pot, tossing to coat with braising liquid.",
    "Stir in Thai basil and Kaffir lime leaves. Season with salt.",
    "Serve hot, garnished with additional Thai basil if desired.",
    "Cook pork to an internal temperature of 63°C / 145°F and let it rest for 3 minutes before serving."
  ],
