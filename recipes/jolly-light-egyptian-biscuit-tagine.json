{
  "title": "Jolly Light Egyptian Biscuit Tagine",
  "description": "A fatty, light, and cozy Egyptian dish featuring digestive biscuits, namul-blanch-season, and is vegetarian-friendly, cooked in a tagine pot.",
  "cuisine": "Egyptian",
  "diet": [
    "vegetarian"
  ],
