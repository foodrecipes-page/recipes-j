  "ingredients": [
    {
      "name": "digestive biscuits",
      "amount": "1 package",
      "notes": "crushed"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "namul",
      "amount": "1 cup",
      "notes": "blanched and seasoned"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "vegetable broth",
      "amount": "2 cups"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in the tagine pot over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the crushed digestive biscuits and cook for 2 minutes, stirring constantly.",
    "Add the blanched and seasoned namul, tomato paste, vegetable broth, salt, and black pepper, and stir to combine.",
    "Bring the mixture to a simmer and cook, covered, for 20 minutes.",
    "Reduce the heat to low and cook, uncovered, for an additional 10 minutes.",
    "Serve the tagine hot, garnished with chopped fresh parsley if desired."
  ],
