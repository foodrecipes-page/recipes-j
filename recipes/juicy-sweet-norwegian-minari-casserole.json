{
  "title": "Juicy Sweet Norwegian Minari Casserole",
  "description": "A sweet and chewy lacto-vegetarian Norwegian dish featuring minari, perfect for a weeknight dinner",
  "cuisine": "Norwegian",
  "diet": [
    "lacto-vegetarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "minari",
      "amount": "1 bunch",
      "notes": "chopped"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "carrot",
      "amount": "2 medium",
      "notes": "peeled and grated"
    },
    {
      "name": "sweet potato",
      "amount": "1 large",
      "notes": "peeled and diced"
    },
    {
      "name": "brown sugar",
      "amount": "1/4 cup"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "cheddar cheese",
      "amount": "1 cup",
      "notes": "shredded"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit",
    "In a large pan, heat the oil over medium heat and saute the onion and minari until tender",
    "In a large bowl, combine the cooked onion and minari, carrot, sweet potato, brown sugar, salt, and pepper",
    "Transfer the mixture to a 9x13 inch baking dish and top with cheese",
    "Bake for 35 minutes or until the cheese is melted and bubbly",
    "Remove from the oven and let cool for a few minutes before serving",
    "Serve hot and enjoy"
  ],
