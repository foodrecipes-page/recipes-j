    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "mother sauce",
      "amount": "1 cup",
      "notes": "homemade or store bought"
    },
    {
      "name": "ti leaves",
      "amount": "12 large",
      "notes": "fresh"
    },
    {
      "name": "queso fresco",
      "amount": "1 cup",
      "notes": "crumbly"
    },
    {
      "name": "cilantro",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons",
      "notes": "freshly squeezed"
    }
  ],
  "instructions": [
    "Heat the mother sauce in a large skillet over medium heat.",
    "Add the diced onion and cook until translucent.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the diced bellflower root doraji and cook until tender.",
    "Warm the ti leaves by wrapping them in a damp paper towel and microwaving for 20 seconds.",
    "Assemble the tacos by spooning the doraji mixture onto a ti leaf and topping with queso fresco and cilantro.",
    "Drizzle with lime juice and serve immediately.",
    "Repeat with the remaining ingredients."
  ],
