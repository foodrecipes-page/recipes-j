      "name": "butternut squash",
      "amount": "1 large",
      "notes": "peeled and cubed"
    },
    {
      "name": "coconut oil",
      "amount": "1/4 cup",
      "notes": "infused with lemongrass and galangal"
    },
    {
      "name": "fish sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "grated ginger",
      "amount": "1 tablespoon"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "chili flakes",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees",
    "Thread the butternut squash cubes onto skewers",
    "In a small bowl, whisk together the coconut oil, fish sauce, lime juice, ginger, garlic, chili flakes, and salt",
    "Brush the mixture onto the squash skewers",
    "Place the skewers on a baking sheet lined with parchment paper",
    "Bake for 20 minutes or until the squash is tender and lightly browned",
    "Increase the oven temperature to broil and cook for an additional 2-3 minutes or until crispy",
    "Remove from the oven and serve hot"
  ],
