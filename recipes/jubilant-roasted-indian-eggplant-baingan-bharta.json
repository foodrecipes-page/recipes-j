  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "Roast the eggplant in the oven for 30 minutes, or until the skin is charred and the flesh is tender.",
    "Remove the eggplant from the oven and let it cool.",
    "Peel the eggplant and chop it into small pieces.",
    "Heat the ghee in a pan over medium heat.",
    "Add the cumin seeds, coriander powder, and salt to the pan and stir for 1 minute.",
    "Add the chopped onion, minced garlic, and grated ginger to the pan and stir for 2 minutes.",
    "Add the confit tomato and roasted eggplant to the pan and stir for 2 minutes.",
    "Stir in the rice krispies and cook for 1 minute.",
    "Wrap the mixture in lotus leaf and serve hot."
  ],
