      "name": "ricotta cheese",
      "amount": "300 g"
    },
    {
      "name": "miso paste",
      "amount": "30 g"
    },
    {
      "name": "coconut milk",
      "amount": "200 ml"
    },
    {
      "name": "patis (shrimp paste)",
      "amount": "10 g"
    },
    {
      "name": "chipotle chili paste",
      "amount": "10 g"
    },
    {
      "name": "sugar",
      "amount": "5 g"
    },
    {
      "name": "lemon juice",
      "amount": "15 ml"
    },
    {
      "name": "vegetable oil",
      "amount": "15 ml"
    },
    {
      "name": "lime zest",
      "amount": "1 tsp"
    },
    {
      "name": "fresh cilantro",
      "amount": "2 tbsp"
    }
  ],
  "instructions": [
    "In a bowl whisk together miso paste, coconut milk, and lemon juice until smooth.",
    "Gently fold in ricotta, patis, and chipotle paste until evenly combined.",
    "Heat oil in a pan over medium heat and pour the curry mixture into the pan.",
    "Simmer uncovered for 12 minutes, stirring occasionally, until the sauce thickens slightly.",
    "Stir in sugar and lime zest, cooking for another 2 minutes.",
    "Remove from heat and allow to cool for a minute before garnishing with cilantro.",
    "Serve hot over steamed rice or use as a dip with crusty bread."
  ],
