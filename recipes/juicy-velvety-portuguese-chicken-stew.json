  "ingredients": [
    {
      "name": "chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "sesame butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "bhuna sauce",
      "amount": "1 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the sesame butter in a large Dutch oven over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the chicken breast pieces and cook until they are browned on all sides.",
    "Add the bhuna sauce, chicken broth, salt, and black pepper, and stir to combine.",
    "Add the chopped carrots and potatoes, and bring the mixture to a boil.",
    "Reduce the heat to low and simmer, covered, for 30 minutes.",
    "Serve the stew hot, garnished with chopped fresh herbs if desired."
  ],
