      "notes": "dried and fermented bonito flakes"
    },
    {
      "name": "onions",
      "amount": "2 medium",
      "notes": "thinly sliced"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "berbere spice",
      "amount": "2 teaspoons",
      "notes": "Ethiopian chili powder"
    },
    {
      "name": "temper",
      "amount": "2 tablespoons",
      "notes": "Ethiopian clarified butter"
    },
    {
      "name": "brown rice",
      "amount": "2 cups",
      "notes": "cooked"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon",
      "notes": "to taste"
    }
  ],
  "instructions": [
    "Heat the temper in a large skillet over medium heat.",
    "Add the sliced onions and cook until they are lightly browned and crispy.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the berbere spice and cook for 1 minute, stirring constantly.",
    "Add the katsuobushi and cook for 2 minutes, stirring constantly.",
    "Add the cooked brown rice and stir to combine with the katsuobushi mixture.",
    "Season with salt and black pepper to taste.",
    "Transfer the hash to a serving platter and garnish with chopped scallions.",
    "Serve hot and enjoy."
  ],
