      "name": "shrimp",
      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": "garlic",
      "amount": "6 cloves",
      "notes": "minced"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "heavy cream",
      "amount": "1 cup"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a kazan cauldron over medium heat.",
    "Add the garlic and cook for 1 minute until fragrant.",
    "Add the shrimp and cook for 2 minutes until they start to turn pink.",
    "Add the butter, paprika, salt, and black pepper, and cook for 1 minute until the butter is melted.",
    "Pour in the heavy cream and lemon juice, and stir to combine.",
    "Bring the mixture to a simmer and cook for 2 minutes until the cream has thickened.",
    "Stir in the parsley and cook for an additional 30 seconds.",
    "Serve the gambas al ajillo hot, garnished with additional parsley if desired."
  ],
