  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit",
    "Mix the almond flour, coconut oil, and salt to make the empanada dough",
    "Roll out the dough and cut into 12 equal pieces",
    "Spoon the chopped Chinese broccoli onto one half of each piece",
    "Drizzle with lemon juice and sprinkle with orange zest",
    "Fold the other half of the dough over the filling and press the edges to seal",
    "Wrap each empanada in a banana leaf and place on a baking sheet",
    "Bake for 25 minutes or until the crust is golden brown",
    "Remove from the oven and let cool for 5 minutes",
    "Serve warm and enjoy"
  ],
