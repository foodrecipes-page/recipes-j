  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "pilchards",
      "amount": "1 can",
      "notes": "drained and flaked"
    },
    {
      "name": "kombu cold extract",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "fresh dill",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "gluten-free breadcrumbs",
      "amount": "1/2 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "Mix the pilchards, kombu cold extract, olive oil, dill, parsley, salt, and pepper in a bowl.",
    "Divide the pilchard mixture among 4 ramekins.",
    "Sprinkle the gluten-free breadcrumbs over the pilchard mixture in each ramekin.",
    "Drizzle the lemon juice over the breadcrumbs.",
    "Place the ramekins on a baking sheet and bake for 20 minutes.",
    "Remove the ramekins from the oven and let them cool for a few minutes.",
    "Serve the gratin hot, garnished with additional parsley if desired."
  ],
