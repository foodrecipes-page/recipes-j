      "name": "ground pork",
      "amount": "1 pound",
      "notes": "preferably with some fat"
    },
    {
      "name": "ground annatto",
      "amount": "2 tablespoons"
    },
    {
      "name": "noodles",
      "amount": "8 ounces",
      "notes": "preferably rice noodles"
    },
    {
      "name": "onion",
      "amount": "1 medium"
    },
    {
      "name": "garlic",
      "amount": "3 cloves"
    },
    {
      "name": "fish sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "soy sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "calamansi juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Cook the noodles according to package instructions, then immediately submerge them in an ice bath to stop the cooking process.",
    "In a large pan, heat 1 tablespoon of oil over medium heat.",
    "Add the diced onion and cook until translucent.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the ground pork and cook, breaking it up with a spoon, until it is no longer pink.",
    "Add the ground annatto, fish sauce, soy sauce, calamansi juice, salt, and black pepper, and stir to combine.",
    "Cook for 5 minutes, stirring occasionally.",
    "Add the cooked noodles to the pan and stir to combine with the pork mixture.",
    "Cook for an additional 2 minutes, stirring constantly."
  ],
