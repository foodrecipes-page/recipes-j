      "name": "old-fashioned rolled oats",
      "amount": "2 cups"
    },
    {
      "name": "all-purpose flour",
      "amount": "1/2 cup"
    },
    {
      "name": "grated carrots",
      "amount": "1 cup"
    },
    {
      "name": "grated zucchini",
      "amount": "1 cup"
    },
    {
      "name": "finely chopped onion",
      "amount": "1/4 cup"
    },
    {
      "name": "minced garlic",
      "amount": "2 cloves"
    },
    {
      "name": "chopped fresh parsley",
      "amount": "1/4 cup"
    },
    {
      "name": "coconut oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat an air fryer to 375°F (190°C).",
    "In a large bowl, mix together oats, flour, grated carrots, grated zucchini, chopped onion, and minced garlic.",
    "Add chopped parsley and mix until well combined.",
    "Using your hands, shape the mixture into 6-8 small billets.",
    "Place the billets in the preheated air fryer basket, leaving about 1 inch of space between each billet.",
    "Cook for 12 minutes, shaking the basket halfway through.",
    "Serve warm and enjoy!"
  ],
