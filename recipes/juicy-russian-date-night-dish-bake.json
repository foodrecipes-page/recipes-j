{
  "title": "Russian Date-Night Bake",
  "description": "A decadent, resinous, and juicy Russian-inspired bake that is perfect for date nights. Made with muscovado sugar, this dish is dairy-free-friendly.",
  "cuisine": "Russian",
  "diet": [],
