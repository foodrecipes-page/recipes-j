      "name": "mushrooms",
      "amount": "1 pound",
      "notes": "button or cremini"
    },
    {
      "name": "instant yeast",
      "amount": "1 teaspoon"
    },
    {
      "name": "vegetable broth",
      "amount": "4 cups"
    },
    {
      "name": "dried thyme",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "In a hot pot vessel, melt the butter over medium heat.",
    "Add the mushrooms and cook until they release their moisture and start to brown.",
    "Add the instant yeast, thyme, salt, and pepper, and stir to combine.",
    "Pour in the vegetable broth and bring the mixture to a simmer.",
    "Reduce the heat to low and let the stew cook for 20 minutes.",
    "Stir in the lemon juice and continue to cook for an additional 5 minutes.",
    "Serve the stew hot, garnished with fresh herbs if desired."
  ],
