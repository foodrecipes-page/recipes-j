{
  "title": "Jovial Light Dutch Mushroom Stew",
  "description": "A savory and light Dutch dish featuring mushrooms and instant yeast, perfect for a weeknight dinner. This recipe is onion and garlic free, making it suitable for those with sensitivities.",
  "cuisine": "Dutch",
  "diet": [
    "vegetarian"
  ],
