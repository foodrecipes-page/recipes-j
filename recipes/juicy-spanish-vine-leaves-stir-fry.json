  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "1 cup of Spanish vine leaves",
      "amount": "",
      "notes": "Washed and drained"
    },
    {
      "name": "2 tablespoons olive oil",
      "amount": "",
      "notes": ""
    },
    {
      "name": "1 medium red bell pepper, chopped",
      "amount": "",
      "notes": ""
    },
    {
      "name": "1 small zucchini, sliced into rounds",
      "amount": "",
      "notes": ""
    },
    {
      "name": "2 cloves garlic, minced",
      "amount": "",
      "notes": ""
    },
    {
      "name": "1/4 cup fresh parsley, chopped",
      "amount": "",
      "notes": ""
    },
    {
      "name": "Juice of 1 lemon",
      "amount": "",
      "notes": "For a tangy dressing"
    },
    {
      "name": "Salt and pepper to taste",
      "amount": "",
      "notes": ""
    }
  ],
  "instructions": [
    "Heat the olive oil in a wok or large skillet over medium heat.",
    "Add the chopped bell pepper and zucchini slices, cooking until they start to soften, about 5 minutes.",
    "Stir in the minced garlic, saut\u00e9ing for an additional minute.",
    "Carefully add the washed vine leaves to the pan. They can be very delicate and may split during cooking, so handle them carefully.",
    "Pour over the lemon juice and season with salt and pepper. Let it cook for about 2-3 minutes until the leaves are slightly softened but still retaining their shape.",
    "Fold in chopped parsley just before serving to preserve its freshness."
  ],
