  "ingredients": [
    {
      "name": "broccoli",
      "amount": "1 head"
    },
    {
      "name": "butter",
      "amount": "4 tablespoons"
    },
    {
      "name": "all-purpose flour",
      "amount": "2 tablespoons"
    },
    {
      "name": "grana padano cheese",
      "amount": "1 cup",
      "notes": "shredded"
    },
    {
      "name": "chili flakes",
      "amount": "1/2 teaspoon"
    },
    {
