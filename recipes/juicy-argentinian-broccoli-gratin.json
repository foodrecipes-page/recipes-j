      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "red onion",
      "amount": "1 small",
      "notes": "diced"
    },
    {
      "name": "bhuna",
      "amount": "2 tablespoons",
      "notes": "see note"
    }
  ],
  "instructions": [
    "Preheat the oven to 400°F (200°C).",
    "Cut the broccoli into florets and set aside.",
    "In a large saucepan, melt the butter over medium heat.",
    "Add the diced onion and cook until translucent, about 5 minutes.",
    "Add the minced garlic and cook for 1 minute, until fragrant.",
    "Add the grana padano cheese and stir until melted.",
    "Add the broccoli florets and toss to coat with the cheese sauce.",
    "Transfer the broccoli mixture to a baking dish.",
    "Sprinkle the shredded cheese, chili flakes, black pepper, and salt on top of the broccoli.",
    "Dot the top with the bhuna and bake for 20-25 minutes, until golden brown.",
    "Serve hot and enjoy!"
  ],
