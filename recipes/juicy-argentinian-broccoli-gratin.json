{
  "title": "Argentinian Broccoli Gratin",
  "description": "A nutty and juicy Argentinian broccoli gratin, made with cheddar cheese and a hint of spice, perfect for a weeknight dinner.",
  "cuisine": "argentinian",
  "diet": [
    "lacto-vegetarian",
