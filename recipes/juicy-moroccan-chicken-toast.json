{
  "title": "Juicy Moroccan Chicken Toast",
  "description": "A flavorful and tender Moroccan dish featuring chicken, served on top of toasted bread with a mustardy twist, perfect for a solo dinner.",
  "cuisine": "Moroccan",
  "diet": [
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "ground cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "Dijon mustard",
      "amount": "2 tablespoons"
    },
    {
      "name": "gluten-free bread",
      "amount": "4 slices"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lemon juice",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together olive oil, cumin, smoked paprika, salt, and black pepper.",
    "Add the chicken to the bowl and toss to coat with the spice mixture.",
    "Transfer the chicken to a baking sheet and bake for 20 minutes or until cooked through.",
    "While the chicken is cooking, toast the gluten-free bread until lightly browned.",
    "In a small bowl, mix together Dijon mustard and lemon juice.",
    "Once the chicken is done, brush the mustard mixture on top of the chicken.",
    "To assemble the dish, place the toasted bread on a plate, top with the chicken, and sprinkle with chopped parsley.",
    "Serve immediately and enjoy."
  ],
