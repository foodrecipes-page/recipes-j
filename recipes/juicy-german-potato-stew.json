{
  "title": "Juicy German Potato Stew",
  "description": "A bitter, creamy sick‑day German stew that pairs vanilla custard with a spicy tadka, all in a gluten‑free friendly one‑pot meal.",
  "cuisine": "German",
  "diet": [
    "gluten-free",
    "vegetarian"
