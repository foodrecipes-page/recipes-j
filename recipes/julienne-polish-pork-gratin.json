  "instructions": [
    "Preheat the oven to 400°F (200°C).",
    "In a large Dutch oven, heat the butter over medium-high heat.",
    "Add the pork and cook until browned on all sides, about 2 minutes.",
    "Add the onion, carrot, and celery, and cook until the vegetables are tender, about 5 minutes.",
    "Add the garlic and cook for 1 minute.",
    "Add the flour and cook for 1 minute.",
    "Add the chicken broth and heavy cream, and bring to a boil.",
    "Reduce the heat to low, cover the pot, and simmer for 10 minutes.",
    "Stir in the sansho pepper and cheddar cheese.",
    "Transfer the pot to the oven and bake for 15 minutes.",
    "Garnish with parsley and serve hot."
  ],
