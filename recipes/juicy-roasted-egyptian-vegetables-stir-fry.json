{
  "title": "Juicy Roasted Egyptian Vegetables Stir-fry",
  "description": "A quick-fix vegetarian-friendly dish featuring roasted vegetables that are rich and juicy, perfect for a meal in under 30 minutes.",
  "cuisine": "Egyptian",
  "diet": [
    "vegetarian"
  ],
