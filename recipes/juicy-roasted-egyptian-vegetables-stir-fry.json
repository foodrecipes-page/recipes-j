    {
      "name": "aubergine (eggplant)",
      "amount": "1 large",
      "notes": "medium-firm, cut into chunks"
    },
    {
      "name": "zucchini",
      "amount": "2 medium",
      "notes": "thinly sliced"
    },
    {
      "name": "red bell pepper",
      "amount": "1 medium",
      "notes": "halved and deseeded"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "finely chopped"
    },
    {
      "name": "garlic cloves",
      "amount": "2-3",
      "notes": "minced"
    },
    {
      "name": "pomegranate molasses",
      "amount": "1 tbsp",
      "notes": "optional, adds a sweet-sour flavor"
    },
    {
      "name": "olive oil",
      "amount": "2 tbsp",
      "notes": "for drizzling and brushing"
    },
    {
      "name": "salt",
      "amount": "to taste",
      "notes": ""
    }
  ],
  "instructions": [
    "Preheat your oven to 450°F (230°C).",
    "Season the aubergine, zucchini, red bell pepper, and onion with salt. Drizzle with olive oil.",
    "Spread the vegetables on a baking sheet in a single layer, drizzling more olive oil over them.",
    "Roast for about 25 minutes, stirring once midway, until tender and slightly caramelized.",
    "In a wok or large skillet, heat 1 tbsp of olive oil over medium-high heat. Add minced garlic and cook for 30 seconds until fragrant.",
    "Add the roasted vegetables to the pan and stir-fry for an additional 5 minutes.",
    "Stir in pomegranate molasses if using, season with salt, and serve hot."
  ],
