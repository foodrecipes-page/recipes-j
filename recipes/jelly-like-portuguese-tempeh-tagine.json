{
  "title": "Portuguese Tempeh Tagine",
  "description": "A hearty and comforting vegan dish featuring tempeh, cooked in a rich and flavorful tagine style, resulting in a fatty and glassy-jelly texture.",
  "cuisine": "Portuguese",
  "diet": [
    "vegan"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "tempeh",
      "amount": "1 block",
      "notes": "cut into small pieces"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "tagine spice blend",
      "amount": "2 tablespoons"
    },
    {
      "name": "vegetable broth",
      "amount": "2 cups"
    },
    {
      "name": "prunes",
      "amount": "1/2 cup",
      "notes": "pitted"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large Dutch oven over medium heat.",
    "Add the chopped onion and cook until it is translucent and starting to caramelize.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the tempeh and cook until it is browned on all sides.",
    "Add the tagine spice blend and cook for 1 minute.",
    "Add the vegetable broth and prunes, and bring the mixture to a boil.",
    "Reduce the heat to low and simmer, covered, for 30 minutes.",
    "Season the tagine with salt and pepper to taste.",
    "Serve the tagine hot, garnished with chopped fresh parsley."
  ],
