      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "cauliflower rice",
      "amount": "2 cups"
    },
    {
      "name": "chicken broth",
      "amount": "1 cup",
      "notes": "low-sodium"
    }
  ],
  "instructions": [
    "Preheat the sous-vide machine to 130 degrees Fahrenheit.",
    "Season the cod fillets with salt, black pepper, and paprika.",
    "Place the cod fillets in a sous-vide bag with vanilla beans, lemon juice, and garlic-infused oil.",
    "Seal the bag and cook for 30 minutes.",
    "Heat olive oil in a large skillet over medium heat.",
    "Add cauliflower rice to the skillet and cook until tender, about 5 minutes.",
    "Add chicken broth to the skillet and stir to combine.",
    "Remove the cod from the sous-vide bag and place on top of the cauliflower rice mixture.",
    "Serve immediately, garnished with lemon wedges and vanilla beans."
  ],
