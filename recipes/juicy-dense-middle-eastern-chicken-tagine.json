{
  "title": "Juicy Dense Middle Eastern Chicken Tagine",
  "description": "A citrusy and dense one-pot Middle Eastern dish featuring peanut butter and score-fat, made with ayurvedic-tamasic-friendly ingredients",
  "cuisine": "Middle Eastern",
  "diet": [
    "gluten-free",
    "dairy-free"
  ],
