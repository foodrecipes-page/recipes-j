  "ingredients": [
    {
      "name": "boneless chicken thighs",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1 1/2 inch pieces"
    },
    {
      "name": "peanut butter",
      "amount": "1/4 cup",
      "notes": "creamy"
    },
    {
      "name": "score-fat",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "coriander",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "chicken broth",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large clay or ceramic tagine or Dutch oven over medium heat",
    "Add the onion and cook until it is lightly browned, about 8 minutes",
    "Add the garlic and ginger and cook for 1 minute, stirring constantly",
    "Add the chicken and cook until it is browned on all sides, about 5-7 minutes",
    "Add the peanut butter, score-fat, cumin, coriander, lemon juice, and chicken broth, and stir to combine",
    "Bring the mixture to a boil, then reduce the heat to low and simmer, covered, for 25 minutes",
    "Season the tagine with salt and pepper to taste",
    "Serve the tagine hot, garnished with chopped fresh herbs if desired"
  ],
