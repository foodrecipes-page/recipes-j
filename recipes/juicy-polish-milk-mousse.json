{
  "title": "Creamy Polish Milk Mousse",
  "description": "A light and airy dessert made with cultured milk, nuka-pickle, and condensed milk. Perfect for a diabetic-friendly breakfast or brunch.",
  "cuisine": "Polish",
  "diet": null,
  "meal": "dessert",
  "ingredients": [
    {
      "name": "Condensed milk",
      "amount": "1 can (14 oz)",
      "notes": "Full-fat"
    },
    {
      "name": "Cultured milk (yogurt)",
      "amount": "1 cup",
      "notes": ""
    },
    {
      "name": "Nuka-pickle juice",
      "amount": "2 tbsp",
      "notes": ""
    },
    {
      "name": "Vanilla extract",
      "amount": "1 tsp",
      "notes": ""
    },
    {
      "name": "Lemon zest",
      "amount": "1 tsp",
      "notes": ""
    },
    {
      "name": "Egg whites",
      "amount": "3 large",
      "notes": ""
    },
    {
      "name": "Granulated sugar",
      "amount": "1/4 cup",
      "notes": "Optional"
    },
    {
      "name": "Salt",
      "amount": "pinch",
      "notes": ""
    },
    {
      "name": "Unsalted butter, melted",
      "amount": "1 tbsp",
      "notes": "Optional"
    }
  ],
  "instructions": [
    "In a blender, combine condensed milk, cultured milk, nuka-pickle juice, vanilla extract, and lemon zest. Blend until smooth.",
    "In a separate bowl, whip egg whites until stiff peaks form.",
    "Gradually add granulated sugar to egg whites and whip until combined.",
    "Fold egg white mixture into the condensed milk mixture until no white streaks remain.",
    "Add melted butter, if using, and fold until combined.",
    "Pour mixture into individual serving cups or a large serving dish.",
    "Chill in the refrigerator for at least 2 hours or until set.",
    "Serve chilled and garnished with a sprinkle of granulated sugar, if desired."
  ],
