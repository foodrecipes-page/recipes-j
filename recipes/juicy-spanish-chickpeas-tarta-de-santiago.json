      "name": "chickpeas",
      "amount": "1 1/2 cups",
      "notes": "drained and rinsed"
    },
    {
      "name": "harissa spice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "eggs",
      "amount": "2 large"
    },
    {
      "name": "flour",
      "amount": "1 1/2 cups"
    },
    {
      "name": "water",
      "amount": "1/2 cup"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large skillet, heat the olive oil over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Stir in the harissa spice and cook for 1 minute.",
    "Add the chickpeas, salt, and black pepper, and cook for 2 minutes.",
    "In a large bowl, whisk together the eggs and flour.",
    "Add the water and whisk until smooth.",
    "Pour the egg mixture over the chickpea mixture and stir to combine.",
    "Pour the mixture into a salt block vessel and bake for 35 minutes."
  ],
