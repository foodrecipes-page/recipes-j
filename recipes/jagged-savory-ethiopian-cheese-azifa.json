  "ingredients": [
    {
      "name": "nabulsi cheese",
      "amount": "1 cup",
      "notes": "crumbly white cheese"
    },
    {
      "name": "chopped chive",
      "amount": "1/4 cup",
      "notes": "fresh"
    },
    {
      "name": "whole wheat bread",
      "amount": "4 slices",
      "notes": "toasted"
    },
    {
      "name": "ghee",
      "amount": "2 tablespoons",
      "notes": "clarified butter"
    },
    {
      "name": "berbere spice",
      "amount": "1 teaspoon",
      "notes": "Ethiopian chili powder"
    },
    {
      "name": "lemon juice",
      "amount": "1 tablespoon",
      "notes": "freshly squeezed"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon",
      "notes": "to taste"
    }
  ],
  "instructions": [
    "Crumble the nabulsi cheese into a bowl and set aside.",
    "Toast the whole wheat bread until it is lightly browned and crispy.",
    "Heat the ghee in a pan over medium heat and add the berbere spice.",
    "Add the chopped chive to the pan and cook until it is lightly wilted.",
    "Add the crumbled cheese to the pan and stir until it is well combined with the chive and spice mixture.",
    "Squeeze the lemon juice over the cheese mixture and stir to combine.",
    "Season the cheese mixture with salt and black pepper to taste.",
    "Serve the cheese mixture over the toasted bread and enjoy."
  ],
